generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          String     @id @default(uuid())
  title       String
  description String
  posterUrl   String
  durationMin Int
  showtimes   Showtime[]
  createdAt   DateTime   @default(now())
}

model Showtime {
  id        String    @id @default(uuid())
  movieId   String
  movie     Movie     @relation(fields: [movieId], references: [id])
  price     Float
  startTime DateTime
  seats     Seat[]
  bookings  Booking[]
}

enum SeatStatus {
  AVAILABLE
  BOOKED
}

model Seat {
  id         String     @id @default(uuid())
  showtimeId String
  showtime   Showtime   @relation(fields: [showtimeId], references: [id])
  row        String     // e.g., "A"
  number     Int        // e.g., 1
  status     SeatStatus @default(AVAILABLE)
  bookingId  String?
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@unique([showtimeId, row, number])
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id          String        @id @default(uuid())
  userId      String?       // Nullable if you want to allow guest checkouts
  user        User?         @relation(fields: [userId], references: [id])
  showtimeId  String
  showtime    Showtime      @relation(fields: [showtimeId], references: [id])
  totalAmount Float
  status      BookingStatus @default(PENDING)
  seats       Seat[]
  createdAt   DateTime      @default(now())
}