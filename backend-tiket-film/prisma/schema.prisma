generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}


model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Movie {
  id          String     @id @default(uuid())
  title       String
  description String
  posterUrl   String
  durationMin Int
  showtimes   Showtime[]
  createdAt   DateTime   @default(now())
}

model Studio {
  id        String     @id @default(uuid())
  name      String     
  capacity  Int        @default(100)
  totalRows Int        @default(10)
  totalCols Int        @default(10)
  createdAt DateTime   @default(now())

  showtimes Showtime[]
}

model Showtime {
  id        String   @id @default(uuid())
  movieId   String
  studioId  String
  price     Float
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  bookings    Booking[]
  bookedSeats BookedSeat[]
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  showtimeId  String
  totalAmount Float
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime    Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  bookedSeats BookedSeat[]
}

model BookedSeat {
  id         String   @id @default(uuid())
  showtimeId String
  bookingId  String
  row        String
  number     Int
  createdAt  DateTime @default(now())

  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, row, number])
}